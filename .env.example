# --- Database ---------------------------------------------------------------
# Local dev uses SQLite so the app runs with zero infra. For production swap the
# provider to "postgresql" in prisma/schema.prisma and point DATABASE_URL at a
# managed Postgres instance.
DATABASE_URL="file:./dev.db"

# --- Auth -------------------------------------------------------------------
# 32+ byte secret used to sign sessions, invitation tokens and magic links.
AUTH_SECRET="dev-only-change-me-to-a-long-random-string"
APP_URL="http://localhost:3000"

# --- Stripe (architecture wired, keys optional in dev) ----------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_CLIENT_ID=""

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="ClientFold <hello@clientfold.com>"
# Resend receiving domain and signing secret for marketplace notification imports.
INBOUND_EMAIL_DOMAIN=""
RESEND_WEBHOOK_SECRET=""

# --- Follow-up Autopilot ----------------------------------------------------
AUTOMATIC_REMINDERS_ENABLED="false"
REMINDER_JOB_SECRET=""
REMINDER_WORKER_URL="http://clientfold:3000/api/internal/reminders/run"
REMINDER_POLL_INTERVAL_MS="900000"
AUTOMATIC_REMINDER_BATCH_SIZE="50"

# --- Object storage (S3-compatible) -----------------------------------------
STORAGE_BUCKET=""
STORAGE_REGION=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT=""

# --- Marketing / attribution ------------------------------------------------
# Server-side conversion API keys are optional and consent-gated.
NEXT_PUBLIC_ATTRIBUTION_COOKIE="cf_attrib"
META_PIXEL_ID=""
META_CONVERSIONS_ACCESS_TOKEN=""
META_GRAPH_VERSION="v24.0"
META_TEST_EVENT_CODE=""
GOOGLE_DATA_MANAGER_ACCESS_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""
GOOGLE_ADS_CONVERSION_ACTION_ID=""
AD_CONVERSION_WEBHOOK_URL=""
AD_CONVERSION_WEBHOOK_SECRET=""
